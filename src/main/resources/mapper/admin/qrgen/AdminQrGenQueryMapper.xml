<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="co.grap.pack.admin.qrgen.mapper.AdminQrGenQueryMapper">

    <resultMap id="qrGenUserResultMap" type="co.grap.pack.qrgen.auth.model.QrGenUser">
        <id property="qrGenUserId" column="qr_gen_user_id"/>
        <result property="qrGenUserLoginId" column="qr_gen_user_login_id"/>
        <result property="qrGenUserPassword" column="qr_gen_user_password"/>
        <result property="qrGenUserEmail" column="qr_gen_user_email"/>
        <result property="qrGenUserNickname" column="qr_gen_user_nickname"/>
        <result property="qrGenUserIsActive" column="qr_gen_user_is_active"/>
        <result property="qrGenUserCreatedAt" column="qr_gen_user_created_at"/>
        <result property="qrGenUserUpdatedAt" column="qr_gen_user_updated_at"/>
        <result property="qrGenUserLastLoginAt" column="qr_gen_user_last_login_at"/>
    </resultMap>

    <resultMap id="qrGenHistoryResultMap" type="co.grap.pack.qrgen.generator.model.QrGenHistory">
        <id property="qrGenHistoryId" column="qr_gen_history_id"/>
        <result property="qrGenHistoryUserId" column="qr_gen_history_user_id"/>
        <result property="qrGenHistoryContentType" column="qr_gen_history_content_type"/>
        <result property="qrGenHistoryContentValue" column="qr_gen_history_content_value"/>
        <result property="qrGenHistorySize" column="qr_gen_history_size"/>
        <result property="qrGenHistoryErrorCorrection" column="qr_gen_history_error_correction"/>
        <result property="qrGenHistoryFgColor" column="qr_gen_history_fg_color"/>
        <result property="qrGenHistoryBgColor" column="qr_gen_history_bg_color"/>
        <result property="qrGenHistoryImagePath" column="qr_gen_history_image_path"/>
        <result property="qrGenHistoryTitle" column="qr_gen_history_title"/>
        <result property="qrGenHistoryMemo" column="qr_gen_history_memo"/>
        <result property="qrGenHistoryCreatedAt" column="qr_gen_history_created_at"/>
        <result property="qrGenUserLoginId" column="qr_gen_user_login_id"/>
    </resultMap>

    <resultMap id="dailyCountResultMap" type="co.grap.pack.admin.dashboard.model.AdminDashboardDailyCount">
        <result property="date" column="date"/>
        <result property="count" column="count"/>
    </resultMap>

    <resultMap id="typeStatResultMap" type="co.grap.pack.admin.qrgen.model.AdminQrGenTypeStat">
        <result property="contentType" column="content_type"/>
        <result property="count" column="count"/>
    </resultMap>

    <select id="countUsers" resultType="long">
        SELECT COUNT(*)
        FROM qr_gen_user
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    qr_gen_user_login_id LIKE CONCAT('%', #{keyword}, '%')
                    OR qr_gen_user_email LIKE CONCAT('%', #{keyword}, '%')
                    OR qr_gen_user_nickname LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="isActive != null">
                AND qr_gen_user_is_active = #{isActive}
            </if>
        </where>
    </select>

    <select id="countHistories" resultType="long">
        SELECT COUNT(*)
        FROM qr_gen_history
        <where>
            <if test="userId != null">
                AND qr_gen_history_user_id = #{userId}
            </if>
            <if test="contentType != null and contentType != ''">
                AND qr_gen_history_content_type = #{contentType}
            </if>
        </where>
    </select>

    <select id="countTodayHistories" resultType="long">
        SELECT COUNT(*)
        FROM qr_gen_history
        WHERE DATE(qr_gen_history_created_at) = CURDATE()
    </select>

    <select id="selectUsers" resultMap="qrGenUserResultMap">
        SELECT *
        FROM qr_gen_user
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    qr_gen_user_login_id LIKE CONCAT('%', #{keyword}, '%')
                    OR qr_gen_user_email LIKE CONCAT('%', #{keyword}, '%')
                    OR qr_gen_user_nickname LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="isActive != null">
                AND qr_gen_user_is_active = #{isActive}
            </if>
        </where>
        ORDER BY qr_gen_user_created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectUserById" resultMap="qrGenUserResultMap">
        SELECT *
        FROM qr_gen_user
        WHERE qr_gen_user_id = #{userId}
    </select>

    <select id="selectHistories" resultMap="qrGenHistoryResultMap">
        SELECT h.*, u.qr_gen_user_login_id
        FROM qr_gen_history h
        LEFT JOIN qr_gen_user u ON h.qr_gen_history_user_id = u.qr_gen_user_id
        <where>
            <if test="userId != null">
                AND h.qr_gen_history_user_id = #{userId}
            </if>
            <if test="contentType != null and contentType != ''">
                AND h.qr_gen_history_content_type = #{contentType}
            </if>
        </where>
        ORDER BY h.qr_gen_history_created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectHistoryById" resultMap="qrGenHistoryResultMap">
        SELECT h.*, u.qr_gen_user_login_id
        FROM qr_gen_history h
        LEFT JOIN qr_gen_user u ON h.qr_gen_history_user_id = u.qr_gen_user_id
        WHERE h.qr_gen_history_id = #{historyId}
    </select>

    <select id="selectDailyHistoryCounts" resultMap="dailyCountResultMap">
        SELECT DATE(qr_gen_history_created_at) AS date,
               COUNT(*) AS count
        FROM qr_gen_history
        WHERE DATE(qr_gen_history_created_at) BETWEEN #{startDate} AND #{endDate}
        GROUP BY DATE(qr_gen_history_created_at)
        ORDER BY date ASC
    </select>

    <select id="selectTypeStats" resultMap="typeStatResultMap">
        SELECT qr_gen_history_content_type AS content_type,
               COUNT(*) AS count
        FROM qr_gen_history
        <where>
            <if test="userId != null">
                qr_gen_history_user_id = #{userId}
            </if>
        </where>
        GROUP BY qr_gen_history_content_type
        ORDER BY count DESC
    </select>

</mapper>
